{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/droidsam1/overreach/blob/main/docs/schemas/overreach.plan.v1.schema.json",
  "title": "overreach.plan v1",
  "description": "Routines and exercise settings for the Overreach app. Exercise names must come from the catalog of the Overreach context.",
  "type": "object",
  "required": [
    "format",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "overreach.plan"
    },
    "version": {
      "const": 1
    },
    "routines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routine"
      }
    },
    "exerciseSettings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exerciseSettings"
      }
    }
  },
  "$defs": {
    "focus": {
      "enum": [
        "strength",
        "hypertrophy",
        "mixed",
        "endurance"
      ]
    },
    "reps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "routine": {
      "type": "object",
      "required": [
        "name",
        "exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable key: keep it when revising the routine."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exerciseSettings": {
      "type": "object",
      "required": [
        "exercise"
      ],
      "additionalProperties": false,
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "scheme": {
          "$ref": "#/$defs/scheme"
        },
        "incrementKg": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "isMainLift": {
          "type": "boolean"
        }
      }
    },
    "scheme": {
      "type": "object",
      "required": [
        "type",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "doubleProgression",
            "linearLoad",
            "repCycle",
            "rpeBased"
          ]
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "minReps": {
          "$ref": "#/$defs/reps"
        },
        "maxReps": {
          "$ref": "#/$defs/reps"
        },
        "reps": {
          "$ref": "#/$defs/reps"
        },
        "repBlocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reps"
          }
        },
        "targetRPE": {
          "type": "number",
          "minimum": 5,
          "maximum": 10,
          "default": 8,
          "description": "Reps-in-reserve scale: 8 means about 2 reps left."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "doubleProgression"
              }
            }
          },
          "then": {
            "required": [
              "minReps",
              "maxReps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "linearLoad",
                  "rpeBased"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "repCycle"
              }
            }
          },
          "then": {
            "required": [
              "repBlocks"
            ]
          }
        }
      ]
    }
  }
}
