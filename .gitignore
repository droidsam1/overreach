# macOS
.DS_Store

# Xcode (the project, Info.plist and entitlements are generated by XcodeGen — never commit them)
*.xcodeproj
*.xcworkspace
App/Info.plist
App/Overreach.entitlements
xcuserdata/
DerivedData/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/

# Local signing / secrets
App/Config/Local.xcconfig
*.p12
*.mobileprovision

# Personal data exports (never commit real health or Strong exports; anonymised fixtures are allowed)
*.fit
strong*.csv
!**/Fixtures/**/*.csv

# Python
__pycache__/
*.pyc

# Agent-local settings (shared agent guidance lives in AGENTS.md, .agents/ and .claude/skills/)
.claude/settings.local.json
