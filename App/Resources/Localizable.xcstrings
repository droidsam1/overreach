    "A draft from your goal. Block lengths are coaching heuristics; adjust as you go.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borrador según tu objetivo. La duración de los bloques es una heurística de entrenamiento; ajústala sobre la marcha."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borrador segundo o teu obxectivo. A duración dos bloques é unha heurística de adestramento; axústaa sobre a marcha."
          }
        }
      }
    },
