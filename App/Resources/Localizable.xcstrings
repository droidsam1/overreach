    "Stop sets a rep or two earlier than usual for a week. Strength lost in a break comes back quickly.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una semana, termina cada serie una o dos repeticiones antes de lo habitual. La fuerza perdida en un parón vuelve rápido."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante unha semana, remata cada serie unha ou dúas repeticións antes do habitual. A forza perdida nun parón volve axiña."
          }
        }
      }
    },
