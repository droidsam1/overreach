    "Add load after each successful session. Repeat after a miss; reduce it after three.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la carga tras cada sesión completada. Repítela si fallas; redúcela tras tres fallos."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube a carga tras cada sesión completada. Repítea se fallas; redúcea tras tres fallos."
          }
        }
      }
    },
    "Add reps until every set reaches the top of the range, then add load and start again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade repeticiones hasta que todas las series lleguen al máximo del rango; después sube la carga y vuelve a empezar."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Engade repeticións ata que todas as series cheguen ao máximo do rango; despois sube a carga e volve empezar."
          }
        }
      }
    },
