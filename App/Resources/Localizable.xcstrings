          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoxe: baixa a {1} e procura {2} repeticións. As dúas últimas veces, algunha serie non chegou a {3} co peso anterior."
          }
        }
      }
    },
    "Today: drop to {1}, about {2} less, after {3} sessions in a row with missing reps. Build back up from there.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy: baja a {1}, un {2} menos, tras {3} sesiones seguidas sin completar las repeticiones. Vuelve a subir desde ahí."
          }
        },
