    "A running rest day must be the only entry on that date.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día de descanso de carrera debe ser la única entrada de esa fecha."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día de descanso de carreira debe ser a única entrada desa data."
          }
        }
      }
    },
    "A sharp rise in weekly load is a rough clue that training has been more demanding.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una subida brusca de la carga semanal da una idea de cuánto se ha endurecido el entrenamiento."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unha subida brusca da carga semanal dá unha idea de canto se endureceu o adestramento."
          }
        }
      }
    },
    "A summary after every session": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen tras cada sesión"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumo tras cada sesión"
          }
        }
      }
    },
    "A week without recorded strength workouts or runs counts as rest for that discipline.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana sin entrenamientos de fuerza o carreras registrados cuenta como descanso para esa disciplina."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unha semana sen adestramentos de forza ou carreiras rexistrados conta como descanso para esa disciplina."
          }
        }
      }
    },
