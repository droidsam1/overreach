            "value": "Para mover unha sesión completada, desvincula primeiro a carreira rexistrada."
          }
        }
      }
    },
    "Today": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy"
          }
        },
        "gl": {
