      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las notas para lo que no dicen los números: molestias, técnica, sueño o ajustes de la máquina. Se guardan con la sesión y se incluyen en las copias."
          }
        },
        "gl": {
          "stringUnit": {
