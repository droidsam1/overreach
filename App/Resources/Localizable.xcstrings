    },
    "Share your training as data: sessions with notes, exercise settings, trends and health metrics. Then ask ChatGPT, Claude or another assistant whatever you need.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu entrenamiento como datos: sesiones con notas, ajustes de ejercicios, tendencias y métricas de salud. Después pregunta a ChatGPT, Claude u otro asistente lo que necesites."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte o teu adestramento como datos: sesións con notas, axustes de exercicios, tendencias e métricas de saúde. Despois pregunta a ChatGPT, Claude ou outro asistente o que precises."
          }
        }
      }
    },
