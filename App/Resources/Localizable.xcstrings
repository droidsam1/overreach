    "Context for reading recovery, never a fixed rule or a diagnosis. It stays in your own data and backups.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve de contexto para interpretar la recuperación; nunca es una regla fija ni un diagnóstico. Se queda en tus datos y tus copias."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve de contexto para interpretar a recuperación; nunca é unha regra fixa nin un diagnóstico. Queda nos teus datos e nas túas copias."
          }
        }
      }
    },
