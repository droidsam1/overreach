    "0 is no pain and 10 is the worst you can imagine. Not medical advice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 es sin dolor y 10 es el peor que puedas imaginar. No es consejo médico."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 é sen dor e 10 é a peor que poidas imaxinar. Non é consello médico."
          }
        }
      }
    },
