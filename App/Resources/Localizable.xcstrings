    "Sets marked W are suggested warm-ups. Mark the ones you do; they are saved apart and do not count for progress. Swipe to delete the ones you skip.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series marcadas con C son calentamientos sugeridos. Marca las que hagas: se guardan aparte y no cuentan para tu progreso. Desliza para borrar las que no hagas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As series marcadas con Q son quecementos suxeridos. Marca as que fagas: gárdanse á parte e non contan para o teu progreso. Desliza para borrar as que non fagas."
          }
        }
      }
    },
