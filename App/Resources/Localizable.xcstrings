    "Swap to a close variation for {1}–{2} weeks, then come back: the new movement is easier to progress and keeps the muscles working.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a una variante parecida durante {1}–{2} semanas y luego vuelve: es más fácil progresar en el movimiento nuevo y los músculos siguen trabajando."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a unha variante parecida durante {1}–{2} semanas e logo volve: é máis doado progresar no movemento novo e os músculos seguen traballando."
          }
        }
      }
    },
    "Switch to a rep range (double progression): adding reps before load gives you more small steps to progress.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a un rango de repeticiones (doble progresión): sumar repeticiones antes que peso te da más pasos pequeños para progresar."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a un rango de repeticións (dobre progresión): sumar repeticións antes que peso dáche máis pasos pequenos para progresar."
          }
        }
      }
    },
