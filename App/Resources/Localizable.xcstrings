    "Both mean the same: RPE = 10 − reps in reserve. Your history and targets do not change.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas significan lo mismo: RPE = 10 − repeticiones en recámara. Tu historial y tus objetivos no cambian."
          }
        },
        "gl": {
