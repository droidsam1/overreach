    "0: you could not have done another. 1: the last rep was a real fight and clearly slowed down. 2–3: hard, but you had some left. 4 or more: comfortable.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0: no podrías haber hecho otra. 1: la última fue una lucha y se frenó claramente. 2–3: costó, pero quedaba margen. 4 o más: cómoda."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "0: non poderías facer outra. 1: a última foi unha loita e freou claramente. 2–3: custou, pero quedaba marxe. 4 ou máis: cómoda."
          }
        }
      }
    },
